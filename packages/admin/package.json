{
  "name": "shoemaker-admin",
  "version": "0.1.1",
  "description": "Admin core for Effect projects: access, audit log and user operations, without UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoemaker.git",
    "directory": "packages/admin"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./access": "./src/access.ts",
    "./server": "./src/server.ts",
    "./better-auth": "./src/better-auth.ts",
    "./sql": "./src/sql.ts",
    "./alchemy": "./src/alchemy.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./access": {
        "types": "./dist/access.d.mts",
        "default": "./dist/access.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./better-auth": {
        "types": "./dist/better-auth.d.mts",
        "default": "./dist/better-auth.mjs"
      },
      "./sql": {
        "types": "./dist/sql.d.mts",
        "default": "./dist/sql.mjs"
      },
      "./alchemy": {
        "types": "./dist/alchemy.d.mts",
        "default": "./dist/alchemy.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "devDependencies": {
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "shoemaker-typescript-config": "workspace:*",
    "shoemaker-utils": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/better-auth": "^2.0.0-beta.87",
    "alchemy": "^2.0.0-beta.87",
    "better-auth": "^1.7.15",
    "effect": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/better-auth": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "catalogSkip": [
    "@alchemy.run/better-auth",
    "alchemy",
    "better-auth",
    "effect"
  ]
}

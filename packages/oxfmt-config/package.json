{
  "name": "@shoe-box-tools/oxfmt-config",
  "version": "0.1.0",
  "description": "Shared oxfmt options and defineShoeboxFormat() for oxfmt.config.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoe-box-tools.git",
    "directory": "packages/oxfmt-config"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "oxlint:check": "oxlint -c ../../oxlint.config.ts .",
    "oxlint:fix": "oxlint -c ../../oxlint.config.ts --fix .",
    "test": "vitest run",
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "devDependencies": {
    "@shoe-box-tools/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": "catalog:"
  }
}

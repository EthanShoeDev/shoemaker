{
  "name": "shoemaker-knip-config",
  "version": "0.2.2",
  "description": "defineKnipConfig(): knip.ts with the shared ignores",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoemaker.git",
    "directory": "packages/knip-config"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "shoemaker-typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "knip": "catalog:"
  }
}

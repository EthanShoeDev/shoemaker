{
  "name": "shoe-box-knip-config",
  "version": "0.1.0",
  "description": "defineKnipConfig(): knip.ts with the shared ignores",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoe-box.git",
    "directory": "packages/knip-config"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "oxlint:check": "oxlint -c ../../oxlint.config.ts .",
    "oxlint:fix": "oxlint -c ../../oxlint.config.ts --fix .",
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore",
    "release:publish": "bun ../../scripts/publish-package.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "shoe-box-typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "knip": "catalog:"
  }
}

{
  "name": "shoe-box-spanoptic",
  "version": "0.0.1",
  "description": "TUI OTEL visualizer for Effect programs",
  "bin": {
    "spanoptic": "./src/cli.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "spanoptic": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.mts",
        "default": "./dist/cli.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "demo": "bun src/demo.ts",
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentui/core": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "shoe-box-typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

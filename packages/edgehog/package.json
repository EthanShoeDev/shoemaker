{
  "name": "shoemaker-edgehog",
  "version": "0.1.0",
  "description": "Feature flags and error tracking inside an Effect project, on its own database",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoemaker.git",
    "directory": "packages/edgehog"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./server": "./src/server.ts",
    "./sql": "./src/sql.ts",
    "./flags": "./src/flags.ts",
    "./openfeature": "./src/openfeature.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./sql": {
        "types": "./dist/sql.d.mts",
        "default": "./dist/sql.mjs"
      },
      "./flags": {
        "types": "./dist/flags.d.mts",
        "default": "./dist/flags.mjs"
      },
      "./openfeature": {
        "types": "./dist/openfeature.d.mts",
        "default": "./dist/openfeature.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "@cucumber/gherkin": "catalog:",
    "@cucumber/messages": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@openfeature/server-sdk": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "shoemaker-admin": "workspace:*",
    "shoemaker-typescript-config": "workspace:*",
    "shoemaker-utils": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "workerd": "catalog:"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "effect": "^4.1.5",
    "shoemaker-admin": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    }
  },
  "catalogSkip": [
    "@openfeature/server-sdk",
    "effect"
  ]
}

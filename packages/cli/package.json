{
  "name": "shoe-box",
  "version": "0.1.0",
  "description": "Scaffold and keep in sync Effect + bun monorepos with Ethan's tooling preferences",
  "license": "MIT",
  "bin": {
    "shoe-box": "./src/bin.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./config": "./src/config/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "shoe-box": "./dist/bin.mjs"
    },
    "exports": {
      "./config": {
        "types": "./dist/config/index.d.mts",
        "default": "./dist/config/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "test": "bun --bun vitest run",
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "catalog:",
    "oxfmt": "catalog:",
    "shoe-box-oxfmt-config": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "shoe-box-typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}

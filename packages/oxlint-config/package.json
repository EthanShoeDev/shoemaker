{
  "name": "shoemaker-oxlint-config",
  "version": "0.1.1",
  "description": "defineShoemakerConfig(): the shared oxlint.config.ts for Effect + bun monorepos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanShoeDev/shoemaker.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "bun ../../scripts/publish-manifest.ts swap",
    "postpack": "bun ../../scripts/publish-manifest.ts restore"
  },
  "dependencies": {
    "@oxlint-flat-config/composer": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "oxlint-flat-config": "catalog:",
    "shoemaker-oxlint-plugins": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "shoemaker-typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/tsgo": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}

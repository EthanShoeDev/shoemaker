{
  "name": "shoe-box-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@changesets/changelog-github": "^1.0.1",
      "@changesets/cli": "^3.0.3",
      "@effect/language-service": "^0.87.5",
      "@effect/opentelemetry": "4.0.6",
      "@effect/platform-bun": "4.0.6",
      "@effect/tsgo": "0.63.0",
      "@effect/vitest": "4.0.6",
      "@opentelemetry/api": "~1.9.1",
      "@opentelemetry/resources": "^2.12.0",
      "@opentelemetry/sdk-trace-base": "^2.12.0",
      "@opentui/core": "^0.1.74",
      "@oxlint-flat-config/composer": "^0.3.1",
      "@oxlint/plugins": "1.90.0",
      "@tanstack/eslint-plugin-query": "^5.105.0",
      "@types/node": "^26.6.6",
      "bun-types": "^1.4.4",
      "effect": "4.0.6",
      "eslint-plugin-playwright": "^2.12.1",
      "eslint-plugin-testing-library": "^7.16.2",
      "jscpd": "^5.4.2",
      "jsonc-parser": "^3.3.1",
      "knip": "^6.43.0",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "oxlint-flat-config": "^0.4.0",
      "oxlint-tsgolint": "7.0.2005",
      "tsdown": "^0.23.3",
      "turbo": "^2.11.10",
      "typescript": "^7.0.2",
      "vitest": "^5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project '!cli' && bun --bun vitest run --project cli",
    "clean": "rm -rf .turbo",
    "oxlint:check": "oxlint -c oxlint.config.ts *.ts scripts",
    "oxlint:fix": "oxlint -c oxlint.config.ts --fix *.ts scripts",
    "oxlint:fix:fix-suggestions": "oxlint -c oxlint.config.ts --fix --fix-suggestions .",
    "oxlint:unsafe:fix": "oxlint -c oxlint.config.ts --fix-dangerously .",
    "oxlint:unsafe:fix:fix-suggestions": "oxlint -c oxlint.config.ts --fix --fix-suggestions --fix-dangerously .",
    "oxfmt:check": "oxfmt -c oxfmt.config.ts --check .",
    "oxfmt:fix": "oxfmt -c oxfmt.config.ts --write .",
    "jscpd:check": "jscpd --config .jscpd.json",
    "knip:check": "knip --no-config-hints --cache",
    "knip:fix:danger": "knip --fix --no-config-hints --cache",
    "catalog:check": "bun packages/cli/src/bin.ts check catalog",
    "catalog:fix": "bun packages/cli/src/bin.ts check catalog --fix",
    "effect-versions:check": "bun packages/cli/src/bin.ts check effect-versions",
    "nix:fmt:check": "bun packages/cli/src/bin.ts check nix-fmt",
    "nix:fmt:fix": "bun packages/cli/src/bin.ts check nix-fmt --fix",
    "shoe-box": "bun packages/cli/src/bin.ts",
    "wizard:local": "bun scripts/try-wizard.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "update:all": "nlx taze major -r -I",
    "update:all:2": "nlx npm-check-updates --interactive --format group -ws --root",
    "update:all:3": "bun update -i",
    "update:nix-flake": "nix flake update",
    "release": "bun scripts/release.ts",
    "release:dry-run": "bun scripts/release.ts --dry-run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shoe-box-knip-config": "workspace:*",
    "shoe-box-oxfmt-config": "workspace:*",
    "shoe-box-oxlint-config": "workspace:*",
    "shoe-box-typescript-config": "workspace:*",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}

{
  "name": "shoemaker-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/better-auth": "2.0.0-beta.87",
      "@alchemy.run/cloudflare": "2.0.0-beta.87",
      "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
      "@changesets/changelog-github": "^1.0.1",
      "@changesets/cli": "^3.0.3",
      "@cucumber/gherkin": "^43.0.0",
      "@cucumber/messages": "^35.0.0",
      "@effect/language-service": "^0.87.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/platform-node-shared": "4.1.5",
      "@effect/sql-d1": "4.1.5",
      "@effect/sql-pg": "4.1.5",
      "@effect/sql-pglite": "4.1.5",
      "@effect/sql-sqlite-node": "4.1.5",
      "@effect/tsgo": "0.73.4",
      "@effect/vitest": "4.1.5",
      "@fission-ai/openspec": "2.2.0",
      "@openfeature/server-sdk": "1.23.0",
      "@opentui/core": "0.9.7",
      "@oxlint-flat-config/composer": "^0.3.1",
      "@oxlint/plugins": "1.94.0",
      "@sentry/cloudflare": "11.17.0",
      "@tanstack/eslint-plugin-query": "^5.108.4",
      "@types/node": "^26.6.6",
      "alchemy": "2.0.0-beta.87",
      "better-auth": "1.7.15",
      "bun-types": "^1.4.5",
      "effect": "4.1.5",
      "eslint-plugin-playwright": "^2.12.2",
      "eslint-plugin-testing-library": "^7.16.3",
      "jscpd": "^5.4.3",
      "knip": "^6.48.0",
      "npm": "12.2.3",
      "oxfmt": "0.80.0",
      "oxlint": "1.94.0",
      "oxlint-flat-config": "^0.4.0",
      "oxlint-tsgolint": "7.0.2008",
      "tsdown": "^0.23.7",
      "turbo": "^2.11.13",
      "typescript": "^7.0.2",
      "vitest": "^5.1.1",
      "workerd": "1.20261026.1"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo",
    "oxlint:check": "oxlint -c oxlint.config.ts *.ts scripts",
    "oxlint:fix": "oxlint -c oxlint.config.ts --fix *.ts scripts",
    "oxlint:fix:fix-suggestions": "oxlint -c oxlint.config.ts --fix --fix-suggestions .",
    "oxlint:unsafe:fix": "oxlint -c oxlint.config.ts --fix-dangerously .",
    "oxlint:unsafe:fix:fix-suggestions": "oxlint -c oxlint.config.ts --fix --fix-suggestions --fix-dangerously .",
    "oxfmt:check": "oxfmt -c oxfmt.config.ts --check .",
    "oxfmt:fix": "oxfmt -c oxfmt.config.ts --write .",
    "jscpd:check": "jscpd --config .jscpd.json",
    "knip:check": "knip --no-config-hints --cache",
    "knip:fix:danger": "knip --fix --no-config-hints --cache",
    "catalog:check": "bun packages/cli/src/bin.ts check catalog",
    "catalog:fix": "bun packages/cli/src/bin.ts check catalog --fix",
    "effect-versions:check": "bun packages/cli/src/bin.ts check effect-versions",
    "nix:fmt:check": "bun packages/cli/src/bin.ts check nix-fmt",
    "nix:fmt:fix": "bun packages/cli/src/bin.ts check nix-fmt --fix",
    "shoemaker": "bun packages/cli/src/bin.ts",
    "wizard:local": "bun scripts/try-wizard.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "openspec": "OPENSPEC_SKILLS_SCOPE=project openspec",
    "update:all": "nlx taze major -r -I",
    "update:all:2": "nlx npm-check-updates --interactive --format group -ws --root",
    "update:all:3": "bun update -i",
    "update:nix-flake": "nix flake update",
    "update:generated-versions": "bun scripts/update-versions.ts",
    "update:openspec-skills": "bun scripts/update-openspec-skills.ts",
    "release": "bun scripts/release.ts",
    "release:dry-run": "bun scripts/release.ts --dry-run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@fission-ai/openspec": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "npm": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shoemaker-knip-config": "workspace:*",
    "shoemaker-oxfmt-config": "workspace:*",
    "shoemaker-oxlint-config": "workspace:*",
    "shoemaker-typescript-config": "workspace:*",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.5"
}

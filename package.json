  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "typecheck": "tsgo --noEmit",
    "fmt:root:nix": "nix fmt flake.nix",
    "fmt:check:root:nix": "nix fmt flake.nix -- -c",
    "oxfmt:fix": "oxfmt --write",
    "oxfmt:check": "oxfmt --check",
    "oxlint:fix": "oxlint -c .oxlintrc.json --type-aware --type-check --report-unused-disable-directives-severity=error --fix .",
    "oxlint:fix:fix-suggestions": "oxlint -c .oxlintrc.json --type-aware --type-check --report-unused-disable-directives-severity=error --fix --fix-suggestions .",
    "oxlint:unsafe:fix": "oxlint -c .oxlintrc.json --type-aware --type-check --report-unused-disable-directives-severity=error --fix-dangerously .",
    "oxlint:unsafe:fix:fix-suggestions": "oxlint -c .oxlintrc.json --type-aware --type-check --report-unused-disable-directives-severity=error --fix --fix-suggestions --fix-dangerously .",
    "oxlint:check": "oxlint -c .oxlintrc.json --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "jscpd:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 jscpd --config .jscpd.json",
    "knip:check": "knip",
    "knip:fix:danger": "knip --fix",
    "catalog:check": "bun scripts/catalog-check.ts",
    "catalog:fix": "bun scripts/catalog-check.ts --fix",
    "update:all": "nlx taze major -r -I",
    "update:all:2": "nlx npm-check-updates --interactive --format group -ws --root",
    "update:nix-flake": "nix flake update"
  },

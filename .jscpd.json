{
  "pattern": "**/*",
  "ignore": [
    "**/docs/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/mnt/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/generated/**",
    "**/eslint.config.{js,ts}"

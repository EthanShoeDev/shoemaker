{
  "pattern": "**/*",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/generated/**",
    "**/*.gen.*",
    "**/vendor/**",
    "**/docs/**",
    "**/mnt/**",
    ".external/**",
    "bun.lock"
  ],
  "threshold": 0,
  "minTokens": 50,
  "minLines": 33,
  "maxLines": 1000,
  "maxSize": "100kb"
}

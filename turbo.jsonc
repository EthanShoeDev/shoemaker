{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  // Task `command` is experimental; it lets every package share one
  // definition of a leaf command instead of a copied script.
  "futureFlags": { "experimentalTaskCommand": true },
  // TMPDIR: tests that write fixtures to os.tmpdir() must see the same temp
  // dir as outside turbo (nix shells and sandboxes set it).
  "globalPassThroughEnv": ["NIX_*", "TMPDIR"],
  // Task-inheritance pattern:
  //   "^task"        -> run `task` in all DEPENDENCY packages first
  //   "with": [...]  -> run these tasks in parallel for the SAME package
  //   "//#task"      -> a root-only task (defined in root package.json)
  // Leaf commands every package shares are task `command`s (argv, no shell),
  // defined here once instead of copied into each package.json. Turbo spawns
  // them without node_modules/.bin on PATH, so binaries go through `bun run`.
  // A package script of the same name overrides one (cli's `test`);
  // `"command": null` in a package's turbo.jsonc opts the package out. Other
  // leaf commands are package scripts. Aggregates (`lint`, `lint:check`) have
  // neither: they only fan out, so turbo is never called from a script.
  // Turbo uses shallow extend: a package overriding a task must copy the whole
  // definition, it is not merged with the root one.
  "tasks": {
    // Tests and typecheck read workspace sources, not build output, so they
    // depend on this no-op instead of `^build`.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "command": ["bun", "run", "tsdown"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "command": ["bun", "run", "tsc", "--noEmit"],
      "dependsOn": ["^transit"],
      "outputLogs": "new-only"
    },
    "test": {
      "command": ["bun", "run", "vitest", "run"],
      "dependsOn": ["^transit"],
      "outputLogs": "new-only"
    },
    "clean": {
      "command": ["rm", "-rf", "dist", ".turbo"],
      "cache": false
    },
    // Publishes a package after its dependencies (scripts/publish-package.ts).
    "release:publish": {
      "command": ["bun", "../../scripts/publish-package.ts"],
      "dependsOn": ["build", "^release:publish"],
      "cache": false,
      "passThroughEnv": [
        "BUN_AUTH_TOKEN",
        "NPM_CONFIG_TOKEN",
        "SHOE_BOX_RELEASE_DRY_RUN"
      ]
    },
    "oxlint:check": {
      "command": ["bun", "run", "oxlint", "-c", "../../oxlint.config.ts", "."],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/oxlint.config.ts"
      ],
      "outputLogs": "new-only"
    },
    "oxlint:fix": {
      "command": [
        "bun",
        "run",
        "oxlint",
        "-c",
        "../../oxlint.config.ts",
        "--fix",
        "."
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/oxlint.config.ts"
      ],
      "outputLogs": "new-only"
    },
    "lint:check": {
      "with": ["oxlint:check", "typecheck", "//#lint:check:root"],
      "outputLogs": "new-only"
    },
    "lint": {
      "with": ["oxlint:fix", "typecheck", "//#lint:root"],
      "outputLogs": "new-only"
    },
    // === Root-only tasks (bodies live in root package.json scripts) ===
    "//#lint:check:root": {
      "with": [
        "//#typecheck",
        "//#oxlint:check",
        "//#oxfmt:check",
        "//#jscpd:check",
        "//#knip:check",
        "//#catalog:check",
        "//#effect-versions:check",
        "//#nix:fmt:check"
      ]
    },
    "//#lint:root": {
      "with": [
        "//#typecheck",
        "//#oxlint:fix",
        "//#oxfmt:fix",
        "//#jscpd:check",
        "//#knip:fix:danger",
        "//#catalog:fix",
        "//#nix:fmt:fix"
      ]
    },
    "//#typecheck": {
      "inputs": ["*.ts", "scripts/**", "tsconfig.json"]
    },
    "//#oxlint:check": {
      "inputs": ["*.ts", "scripts/**"]
    },
    "//#oxlint:fix": {
      "inputs": ["*.ts", "scripts/**"]
    },
    "//#oxfmt:check": {},
    "//#oxfmt:fix": {
      "cache": false
    },
    "//#jscpd:check": {},
    // knip:fix:danger deletes what knip believes is dead; a missing entry in
    // knip.ts makes it delete live code, so review its diff like a codemod.
    "//#knip:check": {},
    "//#knip:fix:danger": {
      "cache": false
    },
    "//#catalog:check": {
      "inputs": ["package.json", "packages/*/package.json"]
    },
    "//#catalog:fix": {
      "cache": false
    },
    "//#effect-versions:check": {
      "inputs": ["bun.lock"]
    },
    "//#nix:fmt:check": {
      "inputs": ["flake.nix", "flake.lock"]
    },
    "//#nix:fmt:fix": {
      "cache": false
    }
  }
}

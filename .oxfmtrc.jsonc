// https://oxc.rs/docs/guide/usage/formatter/config-file-reference.html
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "experimentalTailwindcss": {
    "functions": ["cn", "clsx", "cva"],
    "attributes": ["class", "className", "ngClass", ".*className"],
    "stylesheet": "apps/web/src/index.css",
  },
  "ignorePatterns": [
    "docs/cloned-repos-as-docs/**",
    "CLAUDE.md", // breaks ts block formatting
    "legacy/api/**", // git submodule of legacy API from main branch
  ],
}
